# Vivado / Vitis
*.jou
*.log
*.str
*.debug
*.tmp
*.os
*.pb
*.xpr
*.xsa
*.cache/
.metadata/
*.hw/
*.sim/
*.ip_user_files/
*.runs/
*.srcs/
*.gen/
*.sysgen/

# HLS
*.hls/
*.hlsproj/
solution*/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
/.venv/

# Build artifacts (但保留 board/overlay 下的最终产物)
build/*.bit
build/*.hwh
# build/vivado 下是 Vivado 工程本体，整个不进仓库 —— 上面那些 *.cache/ *.runs/
# 之类只是挡住了里面的大头，剩下的 .Xil / NA / webtalk 报告还是会漏出来。
build/vivado/
build/poster_work/
build/.codex-finalizer/
/.chart-data-*/
# build/hls 下只留构建脚本、优化指令和综合报告，HLS 工程本体（csim_proj 等）不进仓库
build/hls/*
!build/hls/*.tcl
# directives/ 是逐版优化指令；reports/ 是每版综合出来的资源表与 II 表 —— 都是要进仓库的证据
!build/hls/directives/
!build/hls/reports/
# 但 reports/ 里的 `.dcp` 是布线检查点，二进制、单个几 MB 到十几 MB，不进仓库。
# 这条必须写在 `!build/hls/reports/` **后面** —— gitignore 后写的规则优先，
# 写在前面会被那句放行盖掉。文件本身留在本地（report_io_timing.tcl 要用它补 I/O 约束）。
*.dcp

# 临时脚手架（本地跑命令时的 cmd_*.txt、从板子上拷回来的第三方源码副本等）
# 不进仓库：前者是过程文件，后者是别人的版权代码。
build/tmp/

# 排查用的临时 Vivado 脚本（DSP=0 那次的探针）。依赖本地 build/vivado 的临时工程，
# 单独拷进仓库跑不起来。
build/probe/

# Vivado 退出时自动写出的用量统计，和本工程无关。
usage_statistics_webtalk.*

# 板子实验的主机侧原始日志（roundN/ 下的 round_host.log、拉取器 .stamp 等）。
# 整理后的读数进 data/results/，原始流水账留在本地。
tools/_tmp/

# 重建 bit 之前留的旧版备份（v18 那版的 bit + 它对应的 IP 仓库）。是本地快照，
# 不是证据 —— 每一版 bit 的时序/资源报告都在 board/overlay 和 build/hls/reports 里，
# 没必要把整个 IP 仓库再存一份进公开仓库。
build/backup_*/

# Vivado xsim 的编译产物（仿真波形库、编译缓存）—— 每次 run_xsim*.sh 都会重建。
# 仿真用的激励、系数和逐位对拍结果（sim/rtl_sim/*.mem、*.txt）要进仓库，是证据。
# 通配一并挡掉 xsim_work_mb / xsim_work_shell / xsim_work_drc4 / xsim_work_long_4800(_loud)。
sim/rtl_sim/xsim_work*/

# RTL 前端 OOC 综合的中间目录（synth_mb.tcl 每次重建）。
# 综合出来的资源/时序报告在 data/results/rtl_fe_*.rpt，那两份要进仓库。
build/rtl_synth/
build/rtl_impl/

# 2026-10-25 那轮 DMA / 全 PL 直连的一次性脚手架：xsim 工作目录、一份本地快照、
# 控制台日志、带本机绝对路径的构建重试器。位流和它们的时序/资源报告才是证据，
# 在 board/overlay；这堆只是当时跑命令留下的残留。
build/sim_i2s*/
build/sim_dbgchk/
build/snapshot_*/
build/*.txt
!build/requirements.txt
build/*_stdout.log
build/run_*.bat
build/run_pl_build.sh
build/run_cap_build2.sh
build/dbg_*.py
build/read_test.tcl
build/audio_dma_bd_dump.tcl

# 一次性诊断脚本的临时落盘。值得留的两个（A/B 放音对照、codec 全片读数）
# 已经搬进 tools/board_debug/，剩下的是散件和日志。
tools/board_debug/_tmp/

# OS
.DS_Store
Thumbs.db
pynq_venv/
