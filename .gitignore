# Vivado / Vitis
*.jou
*.log
*.str
*.debug
*.tmp
*.os
*.pb
*.xpr
*.xsa
*.cache/
.metadata/
*.hw/
*.sim/
*.ip_user_files/
*.runs/
*.srcs/
*.gen/
*.sysgen/

# HLS
*.hls/
*.hlsproj/
solution*/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Build artifacts (但保留 board/overlay 下的最终产物)
build/*.bit
build/*.hwh
# build/vivado 下是 Vivado 工程本体，整个不进仓库 —— 上面那些 *.cache/ *.runs/
# 之类只是挡住了里面的大头，剩下的 .Xil / NA / webtalk 报告还是会漏出来。
build/vivado/
# build/hls 下只留构建脚本、优化指令和综合报告，HLS 工程本体（csim_proj 等）不进仓库
build/hls/*
!build/hls/*.tcl
# directives/ 是逐版优化指令；reports/ 是每版综合出来的资源表与 II 表 —— 都是要进仓库的证据
!build/hls/directives/
!build/hls/reports/
# 但 reports/ 里的 `.dcp` 是布线检查点，二进制、单个几 MB 到十几 MB，不进仓库。
# 这条必须写在 `!build/hls/reports/` **后面** —— gitignore 后写的规则优先，
# 写在前面会被那句放行盖掉。文件本身留在本地（report_io_timing.tcl 要用它补 I/O 约束）。
*.dcp

# OS
.DS_Store
Thumbs.db
"pynq_venv/" 
pynq_venv/ 
